# Server-only. Never prefix secrets with NEXT_PUBLIC_ and never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional verified Australia-wide road-distance provider. The planner keeps its local estimate if this is absent.
OPENROUTESERVICE_API_KEY=server_only_key_here

# Official Australian fuel providers.
# WA FuelWatch uses the official RSS feed and does not require a secret key.
# NSW FuelCheck v2 covers NSW + Tasmania and requires an API.NSW consumer key/secret.
# Endpoint values must come from the current official API.NSW FuelCheck documentation/account.
NSW_FUELCHECK_CLIENT_ID=issued_by_api_nsw
NSW_FUELCHECK_CLIENT_SECRET=issued_by_api_nsw
NSW_FUELCHECK_TOKEN_URL=official_api_nsw_oauth_token_endpoint
NSW_FUELCHECK_NEARBY_URL=official_api_nsw_fuelcheck_nearby_endpoint

# Queensland developers/data consumers must register for API access before live use.
# The exact endpoint/auth header must come from the current Fuel Prices Queensland developer account/documentation.
QLD_FUEL_API_URL=issued_or_documented_qld_endpoint
QLD_FUEL_API_KEY=issued_by_fuel_prices_qld
QLD_FUEL_API_KEY_HEADER=Authorization
QLD_FUEL_API_KEY_PREFIX=Bearer

# South Australia data publishers must register for the SA Fuel Pricing Information Scheme.
# Use only the endpoint/auth details issued by the scheme aggregator after publisher approval.
SA_FUEL_API_URL=issued_sa_data_publisher_endpoint
SA_FUEL_API_KEY=issued_sa_data_publisher_key
SA_FUEL_API_KEY_HEADER=Authorization
SA_FUEL_API_KEY_PREFIX=Bearer

# Victoria Servo Saver requires authorised API access. The public API fuel-price dataset is 24 hours delayed
# and must never be labelled live/current in GENEVIEVE. Use the Consumer ID/key and endpoint from the approved onboarding docs.
VIC_SERVO_SAVER_API_URL=issued_servo_saver_open_data_endpoint
VIC_SERVO_SAVER_API_KEY=issued_servo_saver_consumer_id
VIC_SERVO_SAVER_API_KEY_HEADER=x-api-key

# Generic fuel adapter remains disabled unless a separately verified provider is used.
FUEL_PRICE_API_URL=https://verified-national-fuel-adapter.example/api/prices
FUEL_PRICE_API_KEY=server_only_key_if_required

# BOM commercial-use gate.
# Anonymous BOM automated feeds/RSS are non-commercial and must not be used for the subscription app.
# Set these only after a Bureau registered/licensed commercial real-time service has been contracted and verified.
BOM_WEATHER_API_URL=https://registered-commercial-bom-service.example/api/weather
BOM_WEATHER_API_KEY=issued_under_bom_data_service_agreement
BOM_DATA_SERVICE_MODE=registered-commercial
BOM_COMMERCIAL_LICENCE_CONFIRMED=false

# Stripe subscription release gate. Checkout remains disabled until all are set.
STRIPE_SECRET_KEY=sk_test_or_live_here
STRIPE_PRICE_ID=price_here
STRIPE_WEBHOOK_SECRET=whsec_here
SUBSCRIPTION_DISPLAY_PRICE=$0.00 AUD
SUBSCRIPTION_BILLING_PERIOD=month
APP_BASE_URL=https://genevieve-grey-nomads.vercel.app
