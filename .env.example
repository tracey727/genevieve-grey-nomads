# Server-only. Never prefix secrets with NEXT_PUBLIC_ and never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional verified Australia-wide road-distance provider. The planner keeps its local estimate if this is absent.
OPENROUTESERVICE_API_KEY=server_only_key_here

# National travel-data provider gates. Keep these unset until the provider, coverage,
# licence and response contract have been verified. The app fails closed when absent.
BOM_WEATHER_API_URL=https://verified-national-weather-adapter.example/api/weather
BOM_WEATHER_API_KEY=server_only_key_if_required
FUEL_PRICE_API_URL=https://verified-national-fuel-adapter.example/api/prices
FUEL_PRICE_API_KEY=server_only_key_if_required

# Stripe subscription release gate. Checkout remains disabled until all are set.
STRIPE_SECRET_KEY=sk_test_or_live_here
STRIPE_PRICE_ID=price_here
STRIPE_WEBHOOK_SECRET=whsec_here
SUBSCRIPTION_DISPLAY_PRICE=$0.00 AUD
SUBSCRIPTION_BILLING_PERIOD=month
APP_BASE_URL=https://genevieve-grey-nomads.vercel.app
